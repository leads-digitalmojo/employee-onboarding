# Copy to .env.local for local development. Never commit the real values.

# Required everywhere: the Storage bucket for uploaded documents.
# Find it in Firebase Console → Storage, or `<project-id>.firebasestorage.app`.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Public web config for the Google sign-in flow (src/lib/firebase-client.ts).
# NOT secrets — safe to expose to the browser; they only identify the Firebase
# project. Get them from Firebase Console → Project Settings → General → Your
# apps → (add a Web app if there isn't one) → SDK setup and configuration.
#
# AUTH_DOMAIN should be the exact Firebase Hosting domain this app is served
# from (e.g. your-site.web.app), not just the project's default domain.
# Firebase Hosting proxies /__/auth/** on that domain straight to Identity
# Platform, keeping the whole sign-in redirect same-origin. If AUTH_DOMAIN
# points at a different domain than the app itself, browsers that block
# cross-site storage access can silently stall after picking a Google account.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-site.web.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Local dev / any host that isn't Firebase or Google Cloud: paste the full
# service account JSON on one line (Firebase Console → Project Settings →
# Service Accounts → Generate new private key). Used for Firestore, Storage,
# AND verifying Google sign-in ID tokens server-side.
#
# On Firebase App Hosting, Cloud Run or Cloud Functions, leave this UNSET —
# the service picks up Application Default Credentials automatically and
# already has the right permissions.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional — only needed if you re-enable AI-assisted letter generation.
# ANTHROPIC_API_KEY=
