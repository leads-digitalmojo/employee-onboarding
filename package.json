{
  "name": "employee-onboarding",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:hostinger": "next build && mkdir -p .next/standalone/.next && cp -r public .next/standalone/public 2>/dev/null || true && cp -r .next/static .next/standalone/.next/static",
    "package:hostinger": "npm run build:hostinger && cd .next/standalone && zip -r ../../hostinger-deploy.zip . > /dev/null",
    "start": "next start -p 3000",
    "seed": "node --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "next": "15.5.22",
    "pdf-lib": "^1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  }
}
